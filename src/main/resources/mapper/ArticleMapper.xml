<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bilibili.myblogbackend.mapper.ArticleMapper">
    <update id="updateArticle" parameterType="com.bilibili.myblogbackend.dto.po.Article">
        update article
        <set>
            <if test="articleUrl != null">
                article_url = #{articleUrl},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="introduce != null">
                    introduce = #{introduce},
            </if>

        </set>
        where id = #{id}
    </update>
</mapper>